# Copy to backend/.env and fill in what you need. Everything here is optional — the app
# starts without any of it and each tool says plainly when it needs something.
#
# There are deliberately no defaults for the hosted endpoints below. They point at models
# and data *you* deploy under your own account, so that a clone of this repo never sends
# your generation traffic (or anyone else's) to a stranger's Space.

# --- Local backend: where data lives, and who may talk to it -------------------
# Where the SQLite database and generated outputs go. The desktop app sets this to your OS
# user-data folder when it launches the backend; leave it empty and a standalone/dev run
# uses backend/data/ instead.
DATA_DIR=

# Guards the local API. Without it, anything that can reach 127.0.0.1 can call this backend
# — including a web page open in your browser, which can fetch http://127.0.0.1:8756/library
# and read the response. That was demonstrated on this app, not theorised, and an origin
# check alone does not fix it: the packaged renderer runs from file:// and sends
# `Origin: null`, which any sandboxed iframe can also claim.
#
# The desktop app generates a fresh token per session and passes it in, so you never set this
# by hand for normal use. Leaving it empty disables the check, which is what keeps a plain
# `uvicorn app.main:app` usable while developing — the backend says so loudly at startup
# rather than failing open quietly. Don't leave it empty on anything you don't fully trust
# the network of.
MRAIM_API_TOKEN=

# --- Hugging Face ------------------------------------------------------------
# Read access is enough for normal use. Write access is only needed to publish your own
# Spaces or the RAG dataset (see scripts/rag/publish_index.py).
# The desktop app stores this in its encrypted settings instead; this is for running the
# backend or the scripts directly.
HF_TOKEN=

# --- Fine-tuned model Spaces -------------------------------------------------
# Deploy each as a Hugging Face Space, then point these at them.
BLOG_WRITER_SPACE=
EMAIL_WRITER_SPACE=
BRANDFORGE_SPACE=

# --- Marketing Plan on a Space (optional) ------------------------------------
# Generate the whole plan on a Hugging Face Space instead of on this machine — keyword
# research, the SEO/social/ads plans, the composed strategy, and its own grounding. Nothing
# to download and no index to warm up.
#
# Empty is a working configuration: the plan is then built locally exactly as it always was,
# using the retrieval index below.
#
# Your Hugging Face token goes with the request, because the inference is billed to you
# rather than to whoever runs the Space — so send a fine-grained, inference-only token
# unless the Space is your own. Your Google Ads credentials go with it too, so the official
# keyword tier runs against your account; without them the Space uses its free tiers.
#
# Either form works: "owner/space-name" or a full https://owner-space-name.hf.space URL.
MARKETING_PLAN_SPACE=

# --- Marketing Plan retrieval index ------------------------------------------
# Only used when MARKETING_PLAN_SPACE is empty.
# A private HF Dataset holding the ~1.1 GB Chroma index. The app downloads it once, on the
# first plan generation, using your own token. Leave empty and plans are still written —
# just without retrieval grounding.
#
#   1. python scripts/rag/compact_index.py                        (2.4 GB -> 1.1 GB)
#   2. python scripts/rag/publish_index.py --repo you/dm-rag-index
#   3. set the repo id below
MARKETING_PLAN_RAG_DATASET=

# --- Email open/click tracking -----------------------------------------------
# Your own tracking Space. Empty simply turns tracking off; no mail is routed through
# anyone else's host.
MAIL_TRACKER_URL=
# Shared secret your tracking Space checks on its /events feed — must match the value set
# there. Empty turns the sync off; it is never sent unauthenticated.
MAIL_TRACKER_SYNC_SECRET=

# --- Brand Studio on your own GPU (optional) ---------------------------------
# Only needed for the bring-your-own-Modal path. New Modal accounts get roughly $30 of
# free GPU credit.
BRANDFORGE_MODEL=
BRANDFORGE_IMAGE_BUCKET=

# --- Optional: remote retrieval instead of a local index ----------------------
# Point this at a retrieval Space (resources/rag-retrieval-space) and the Marketing Plan
# tool queries it instead of downloading the 1.1 GB corpus. Empty = local retrieval, which
# is the default and keeps every query on this machine.
#
# Only set this if you host the Space: a shared endpoint routes every user's plan through
# whoever deployed it, which is the coupling the rest of this app avoids.
#
# What travels: the *prompt* goes to the Space, which drops the retrieved passages in and
# runs the model there, and only the finished text comes back. That protects the corpus —
# extracts never cross the wire — but it means your Hugging Face token goes with each
# request, because the generation is billed to you. Send a fine-grained, inference-only
# token unless the Space is your own.
RAG_SERVICE_URL=
# Shared key the Space checks (its RAG_APP_KEY). Without it, anyone who finds the URL can
# use the endpoint.
RAG_SERVICE_KEY=

# --- Datasets and models ------------------------------------------------------
# None of these ship inside the app. They are fetched from Hugging Face on first use and
# cached in your data directory (see backend/app/services/hf_assets.py). A checkout that
# still has the files on disk uses those and never calls out.
#
# Publish your own copies with:
#   python scripts/hf/publish_assets.py --owner your-hf-username --dry-run
#
# A private or gated repo needs the Hugging Face token from Settings to have access to it.
HF_ASSETS_CTR_MODEL_REPO=
HF_ASSETS_INFLUENCER_REPO=
HF_ASSETS_GUEST_POST_REPO=

# The CTR model's training data. Read only by backend/ml/ctr/train_ctr_model.py when
# refitting the model — the app never touches it, and it is not distributed. Keep the repo
# private; a fitted model can be shared without the corpus behind it.
CTR_TRAINING_REPO=
