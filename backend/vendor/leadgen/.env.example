# Lead Gen Agent settings for this user.
#
# This file doubles as the SETTINGS SCHEMA: config.py parses it so that section
# headers become groups, the comment block above each KEY= becomes its help text,
# and KEY=default supplies the name + default. Documenting a variable here makes it
# appear in the app's Settings screen automatically — the two can never drift.
#
# The self-hosted service URLs (Reacher, SearXNG) and the data directory are NOT
# listed here: Electron generates and injects them (LEADGEN_REACHER_URL,
# LEADGEN_SEARXNG_URL, LEADGEN_DATA_DIR), so they are never user-editable settings.

# --- Language model -----------------------------------------------------------
# Where the *reasoning* calls run (ICP synthesis, lead qualification, the follow-up
# decision). "hf" bills per token to your Hugging Face token below; "ollama" runs a
# local model for offline dev. The actual outreach EMAILS are written by the app's
# Email Writer Space instead, not by this backend.
LLM_BACKEND=hf

# Your Hugging Face access token. REQUIRED when LLM_BACKEND=hf — every reasoning call
# is billed to it (Inference Providers, pay-as-you-go), so the agent fails fast with a
# clear message rather than degrading silently if it is missing or lacks the
# "Make calls to Inference Providers" permission.
HF_TOKEN=

# The HF-hosted instruct model for reasoning calls. Any OpenAI-compatible instruct
# model on the Inference Providers router works; swap it here with no code change.
# Default is a low-cost Mixture-of-Experts model (80B total / ~3B active per token),
# already vetted for this app in the Social Post Generator.
LLM_MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct

# Local Ollama model + endpoint, used only when LLM_BACKEND=ollama.
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_URL=http://localhost:11435

# --- Sending mailbox (SMTP) ---------------------------------------------------
# The agent sends approved outreach from YOUR OWN mailbox over SMTP — the same idea
# as an app password used elsewhere in this app. Use a mailbox dedicated to outreach
# to keep sender reputation isolated from your personal mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# The display name and address recipients see (the address must be one your SMTP
# account is allowed to send as).
MAILBOX_FROM_NAME=
MAILBOX_FROM_EMAIL=

# --- Reply inbox (IMAP) -------------------------------------------------------
# The agent reads replies over IMAP to drive agentic follow-up (classify the reply,
# then draft a threaded response, wait, or mark the deal complete). Usually the same
# mailbox as SMTP above.
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=

# --- Outreach limits ----------------------------------------------------------
# Max outreach emails per day (warm-safe cap). Email-finding is gated by this too:
# the agent only resolves as many addresses as it can actually send today.
DAILY_CAP=20

# The daemon only sends during this local-time window (24h clock), so outreach looks
# like a person working normal hours rather than a bot firing at 3am.
ACTIVE_HOURS_START=9
ACTIVE_HOURS_END=18

# --- Discovery ----------------------------------------------------------------
# Which discovery backends to use, comma-separated: "overpass" (OpenStreetMap, best
# for local/regional businesses) and/or "searxng" (self-hosted web search, broader).
DISCOVERY_BACKENDS=overpass,searxng

# The Overpass API endpoint. The public instance is free and keyless; point this at a
# self-hosted Overpass if you run one.
OVERPASS_URL=https://overpass-api.de/api/interpreter
