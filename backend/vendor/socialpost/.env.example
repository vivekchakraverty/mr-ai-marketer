# Copy to .env and fill in. Never commit .env.
# In GitHub Actions these are mapped from repository secrets of the same name.
#
# Everything below is also editable from the app's Settings tab (or
# `python -m src.config --set KEY=VALUE`), which writes back to this file.

# --- App behaviour -------------------------------------------------------------
# Whether the Settings tab / config CLI may edit this file. On by default (the
# target is a local desktop/standalone run). Set to false on a shared or PUBLIC
# deployment, where writing credentials to a host file from a web request would be
# an exposure — the tab then shows values read-only.
ALLOW_UI_CONFIG=true

# --- Storage backend ---------------------------------------------------------
# supabase (default) — hosted Postgres. Required if you run jobs on GitHub
#                      Actions, because a runner has no disk that survives a run.
# sqlite             — fully local. One file, no accounts, no network. Pair it
#                      with `python -m src.scheduler --daemon` instead of Actions.
#                      SUPABASE_* below are then unused.
DB_BACKEND=supabase

# Only used when DB_BACKEND=sqlite. Default: ./data/app.db
# The schema is applied automatically on first connect — nothing to paste.
SQLITE_PATH=

# --- Supabase (required unless DB_BACKEND=sqlite) ---
# Project URL, e.g. https://abcdefghijklmno.supabase.co
SUPABASE_URL=
# SERVICE ROLE key (Settings -> API -> service_role). Bypasses RLS. Never expose client-side.
SUPABASE_SERVICE_KEY=

# --- LLM provider --------------------------------------------------------------
# gemini (default) — Google Gemini free tier. Needs GEMINI_API_KEY below.
# hf              — Hugging Face Inference Providers. Needs HF_TOKEN below.
#                   The token IS the billing identity: generations are charged to
#                   whoever it belongs to. Gives you open-weight models (Llama,
#                   Qwen, DeepSeek) instead of one vendor's free tier.
#
# Whichever you pick:  python -m src.llm --probe
# tells you which models your credential can actually reach and which finish
# cleanly at this project's token budgets. Run it before debugging anything else.
LLM_PROVIDER=gemini

# --- Google Gemini (required when LLM_PROVIDER=gemini) ---
# https://aistudio.google.com/app/apikey  (free tier)
GEMINI_API_KEY=
# Optional override; defaults to gemini-flash-lite-latest.
# Avoid thinking models: they spend the whole token budget reasoning and return
# empty text at our 300-token KB-triage budget.
GEMINI_MODEL=

# Optional override when LLM_PROVIDER=hf; defaults to Qwen/Qwen3-Next-80B-A3B-Instruct.
# Must be an -Instruct (non-thinking) variant — Qwen3-8B is NOT labelled
# "thinking" but has it on by default and returns empty text at our budgets.
HF_MODEL=

# --- Bluesky (required by ingest + snapshot) ---
# Your handle, e.g. yourname.bsky.social
BLUESKY_HANDLE=
# App password from Settings -> App Passwords. NOT your account password.
BLUESKY_APP_PASSWORD=

# --- Hugging Face ---
# Your account token: https://huggingface.co/settings/tokens
# Used for: deploying the telemetry Space (Write access needed), identifying this
# instance to the telemetry endpoint, and (once enabled) HF inference billing.
HF_TOKEN=
# Fine-grained token with write access to ONLY the telemetry dataset repo.
# Created AFTER the dataset repo exists; becomes the Space's HF_ORG_TOKEN secret.
# Only the maintainer deploying the ingest Space needs this — not end users.
HF_INGEST_TOKEN=

# --- Pooled telemetry (optional) -----------------------------------------------
# When set, this instance sends ANONYMOUS performance metrics to the ingest Space
# so results improve for everyone, and generation becomes gated behind a one-time
# consent screen (participation is a precondition of use, by design). Leave BLANK
# to disable telemetry entirely — no consent gate, nothing sent.
#
# The distribution intended for pooling ships with this set. A private clone that
# does not want to participate simply leaves it empty.
# Sending reuses HF_TOKEN above (whoami identity only; no billing, no scope needed).
TELEMETRY_ENDPOINT=

# MAINTAINER ONLY. The HF dataset the ingest Space writes to, read by
# `python -m src.jobs.benchmark --source pool` to analyse pooled results across
# instances. End users never set this. Needs an HF_TOKEN with read access to it.
TELEMETRY_DATASET=

# --- GitHub (required by watchdog only; NOT used in local mode) ---
# Fine-grained PAT with Actions: read/write on this repo. Used to workflow_dispatch
# refresh_exemplars.yml when performance regresses.
# Leave blank when running via src/scheduler.py — there is no workflow to dispatch,
# and watchdog logs its decision instead of firing one.
GH_PAT=
# owner/repo, e.g. vivek/social-post-generator. Auto-detected in Actions via GITHUB_REPOSITORY.
GH_REPO=
