# Copy to .env and fill in what you need. Everything here is optional — without it the
# monitor still checks every public Space, local service and module.

# Required for `e2e`; also reveals the private BrandForge Space in the health run.
HF_TOKEN=

# Reserved for end-to-end checks that spend YouTube Data API quota.
YOUTUBE_API_KEY=

# Override only if you run the backend somewhere other than the default.
# HEALTHMON_BACKEND_URL=http://127.0.0.1:8756
