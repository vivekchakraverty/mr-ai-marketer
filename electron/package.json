{
  "name": "mr-ai-marketer",
  "version": "0.2.1",
  "description": "Mr. AI Marketer — desktop marketing studio",
  "main": "./out/main/index.js",
  "//desktopName": "Root level, not build.linux — app-builder-lib reads it from package.json metadata (LinuxTargetHelper), and linux.syncDesktopName is the flag that makes it take effect. Electron uses it as app_id/WM_CLASS so Linux desktops associate running windows with the .desktop entry.",
  "desktopName": "mr-ai-marketer.desktop",
  "homepage": "https://github.com/vivekchakraverty/mr-ai-marketer",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivekchakraverty/mr-ai-marketer.git"
  },
  "author": {
    "name": "Vivek Chakraverty",
    "email": "vivekchakraverty@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "com.vivekchakraverty.mraimarketer",
    "productName": "Mr. AI Marketer",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "vivekchakraverty",
        "repo": "mr-ai-marketer"
      }
    ],
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/mr-ai-marketer-backend",
        "to": "backend"
      },
      {
        "from": "../resources/ffmpeg",
        "to": "ffmpeg"
      },
      {
        "from": "../resources/activepieces",
        "to": "activepieces"
      },
      {
        "from": "../resources/leadgen",
        "to": "leadgen"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../build/icon.ico",
      "artifactName": "${name}-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "../build/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "${name}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "../build/icon.png",
      "category": "Office",
      "artifactName": "${name}-${version}-${arch}.${ext}",
      "synopsis": "Local-first AI marketing suite",
      "maintainer": "Vivek Chakraverty <vivekchakraverty@gmail.com>",
      "syncDesktopName": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mr. AI Marketer",
      "uninstallDisplayName": "${productName} ${version}",
      "license": "../LICENSE",
      "runAfterFinish": true,
      "menuCategory": false,
      "include": "installer.nsh"
    }
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "electron-updater": "^6.8.9",
    "hls.js": "^1.6.17",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.6"
  }
}
