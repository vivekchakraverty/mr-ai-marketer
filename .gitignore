# Node / Electron
node_modules/
electron/out/
electron/dist/
electron/dist-electron/
# TypeScript's incremental-build cache. Rewritten by every typecheck and build, so
# tracking it meant a modified file in `git status` after any of them.
*.tsbuildinfo

# Python
# Deliberately unscoped: Python lives in backend/, healthmon/, scripts/ and several
# resources/*-space/ dirs, and a backend-only rule silently let 13 .pyc files through.
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
backend/dist/
backend/build/
# (backend.spec itself is hand-authored and tracked — only PyInstaller's build/dist output above is ignored)

# Packaging output
electron/release/
# ffmpeg/ffprobe binaries are fetched per-platform at build time (see resources/ffmpeg/README),
# not committed — ~400MB and license-bearing binaries don't belong in git history.
resources/ffmpeg/*/*.exe
resources/ffmpeg/*/ffmpeg
resources/ffmpeg/*/ffprobe

# Local data / secrets — never commit tokens, credentials, or generated user content
backend/data/
backend/vendor/*/data/*.db
*.env
.env
config.json
mr-ai-marketer.sqlite3

# Dev-only junction to the real (2.3GB) RAG index — M8 downloads this from a private
# HF Dataset at runtime instead; this local link only exists for dev-machine testing.
backend/vendor/dmstrategy/rag_index/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json

# Generated output from the tools (documents, screenshots, images)
outputs/

# Health monitor: run history and its local secrets
healthmon/state/
healthmon/.env

# Stray file Windows shells create from a mistyped redirect
nul

# Claude Code's local permission file. Already covered by a global ignore on the original
# author's machine, which is exactly why it belongs here too — protection that depends on
# one developer's personal git config is not protection. It records the commands run in
# this repo, including URLs of your own infrastructure.
.claude/settings.local.json

# Security tooling and its output. `scripts/security/scan.py` writes reports here, and
# .tools/ is the documented place to drop a semgrep venv so the script can find it.
.security-reports/
.tools/
